# Copy to .env.local for local development; set these in your host's dashboard for production.

# Required for the Director to write real plans. Without it, /api/plan returns the sample plan
# and the app labels it "Sample plan". Server-side only — never prefix with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=

# Only for keys that aren't scoped to a workspace (they start with sk-ant-usr-): the workspace ID
# to bill, from console.anthropic.com → Settings → Workspaces. A workspace-scoped key (sk-ant-api…) is simpler.
# ANTHROPIC_WORKSPACE_ID=

# Optional, recommended. OpenAI key for speech-to-text on the server (whisper-1, word timings), so
# creators get exact captions automatically without downloading a speech model. Without it, exact
# captions run on the creator's device. Server-side only.
OPENAI_API_KEY=

# Optional. Transcriptions per client IP per 10 minutes (default: 60). Model (default: whisper-1).
# TRANSCRIBE_RATE_LIMIT=60
# OPENAI_TRANSCRIBE_MODEL=whisper-1

# Optional. Pexels API key (free, pexels.com/api) for "Find stock footage" on silent shots. Without it the
# search is hidden. Server-side only. STOCK_RATE_LIMIT: searches/downloads per client IP per 10 minutes (default 40).
# PEXELS_API_KEY=
# STOCK_RATE_LIMIT=40

# Accounts and projects (optional — without them the app makes single videos with no sign-in).
# Clerk (clerk.com → your application → API keys). Read when the app runs, so no rebuild is needed.
# CLERK_PUBLISHABLE_KEY=pk_live_...
# CLERK_SECRET_KEY=sk_live_...
# Postgres for projects, ideas and saved videos (Railway: add the Postgres plugin and reference its DATABASE_URL).
# Tables are created automatically on first use.
# DATABASE_URL=postgresql://user:pass@host:5432/db
# Local development only: DEV_AUTH=1 signs everyone in as one test user (ignored in production).
# DEV_AUTH=1
# Optional. Idea suggestions per user per 10 minutes (default: 12).
# IDEAS_RATE_LIMIT=12

# Optional. Model the Director uses (default: claude-opus-5-5).
# DIRECTOR_MODEL=claude-opus-5-5

# Optional. Plans per client IP per 10 minutes (default: 10).
# PLAN_RATE_LIMIT=10

# Optional. Questions and feedback requests to the Director per client IP per 10 minutes (default: 40).
# CHAT_RATE_LIMIT=40

# Optional. Director edit plans per client IP per 10 minutes (default: 10).
# EDIT_RATE_LIMIT=10

# Optional. Writer requests (questions, drafts, revisions) per client IP per 10 minutes (default: 20).
# WRITER_RATE_LIMIT=20

# Optional. Public URL, used for social-share metadata, e.g. https://viraldirector.app
# NEXT_PUBLIC_SITE_URL=
